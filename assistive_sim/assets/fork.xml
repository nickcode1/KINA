<!-- Dinner fork with a slim handle and a slightly built-up (adaptive) rubber grip sleeve.
     Body origin = centre of the grip sleeve (the grasp point). Fork points along +x.
     Lengths: handle 15 cm (x -0.075 .. 0.075), neck 1.7 cm, palm 1 cm, tines 2.8 cm -> 20.5 cm total.
       handle core : 1.0 cm wide x 0.7 cm thick (rounded butt)
       grip sleeve : 1.2 cm wide x 0.8 cm thick, 7 cm long (high-friction rubber, what the gripper holds)
       neck        : 0.5 cm wide x 0.3 cm thick steel, steps down to the head
       head        : 2.2 cm wide palm + 4 tines (2.4 mm wide, 2.8 cm long)
     The fork rests on the grip sleeve bottom (z = -0.004) and the head bottom (z = -0.004).
     Site "tip" sits at the centre of the tines, 1 cm from their ends. -->
<mujoco model="fork">
  <worldbody>
    <body>
      <body name="object">
        <!-- handle (plastic) -->
        <geom name="handle" type="box" size="0.0725 0.005 0.0035" pos="0.0025 0 0" rgba="0.2 0.45 0.85 1"
              group="0" density="1200" friction="1.2 0.01 0.001" condim="4"/>
        <geom name="handle_butt" type="cylinder" size="0.005 0.0035" pos="-0.07 0 0" rgba="0.2 0.45 0.85 1"
              group="0" density="1200" friction="1.2 0.01 0.001" condim="4"/>
        <!-- built-up grip sleeve (rubber) -->
        <geom name="grip" type="box" size="0.035 0.006 0.004" pos="0 0 0" rgba="0.15 0.15 0.18 1"
              group="0" density="1100" friction="1.8 0.02 0.002" condim="4"/>
        <!-- steel neck + head -->
        <geom name="neck" type="box" size="0.0085 0.0025 0.0015" pos="0.0835 0 -0.0025" rgba="0.78 0.78 0.8 1"
              group="0" density="7800" friction="1.0 0.01 0.001" condim="4"/>
        <geom name="palm" type="box" size="0.005 0.011 0.0015" pos="0.097 0 -0.0025" rgba="0.78 0.78 0.8 1"
              group="0" density="7800" friction="1.0 0.01 0.001" condim="4"/>
        <geom name="tine0" type="box" size="0.014 0.0012 0.0015" pos="0.116 -0.0090 -0.0025" rgba="0.78 0.78 0.8 1" group="0" density="7800" condim="4"/>
        <geom name="tine1" type="box" size="0.014 0.0012 0.0015" pos="0.116 -0.0030 -0.0025" rgba="0.78 0.78 0.8 1" group="0" density="7800" condim="4"/>
        <geom name="tine2" type="box" size="0.014 0.0012 0.0015" pos="0.116 0.0030 -0.0025" rgba="0.78 0.78 0.8 1" group="0" density="7800" condim="4"/>
        <geom name="tine3" type="box" size="0.014 0.0012 0.0015" pos="0.116 0.0090 -0.0025" rgba="0.78 0.78 0.8 1" group="0" density="7800" condim="4"/>
        <site name="tip" type="sphere" size="0.003" pos="0.120 0 -0.0025" rgba="0 1 0 1"/>
        <site name="handle_center" type="sphere" size="0.002" pos="0 0 0" rgba="0 0 0 0"/>
      </body>
      <site rgba="0 0 0 0" size="0.005" pos="0 0 -0.004" name="bottom_site"/>
      <site rgba="0 0 0 0" size="0.005" pos="0 0 0.004" name="top_site"/>
      <site rgba="0 0 0 0" size="0.005" pos="0.130 0 0" name="horizontal_radius_site"/>
    </body>
  </worldbody>
</mujoco>
